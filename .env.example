# Your linked Signal phone number, E.164 format (the account signal-cli is linked as).
SIGNAL_ACCOUNT=+491700000000

# Optional: signal-cli config/data directory (where the linked account lives).
# Unset uses signal-cli's own default (~/.local/share/signal-cli).
# SIGNAL_CONFIG_DIR=/home/you/.local/share/signal-cli

# Optional: path to the signal-cli binary. Defaults to `signal-cli` on PATH.
# SIGNAL_CLI_PATH=/opt/homebrew/bin/signal-cli

# Optional: Unix domain socket the ingestion daemon exposes for JSON-RPC.
# MUST stay short (AF_UNIX ~104 char limit). Defaults to
# $XDG_RUNTIME_DIR/sig/signal-cli.sock (or a short /tmp path if unset).
# SIGNAL_SOCKET=/run/user/1000/sig/signal-cli.sock

# Optional: SQLite message store path. Defaults to
# $XDG_STATE_HOME/sig/messages.db (or ~/.local/state/sig/messages.db).
# SIGNAL_DB=/home/you/.local/state/sig/messages.db

# Optional: base URL of a deployed sig-semanticd sidecar for hybrid search.
# SIGNAL_SEMANTICD_URL=http://localhost:4499
