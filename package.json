{
  "name": "@myceliumhq/sig",
  "version": "1.1.0",
  "description": "Agent-facing CLI for Signal messenger (built on signal-cli). Also ships a standalone MCP server and an ingestion daemon for shell-less hosts.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "agent",
    "mcp",
    "signal",
    "signal-cli",
    "messaging"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myceliumhq/sig.git"
  },
  "exports": {
    "./semantic-adapter": {
      "types": "./dist/semantic-adapter.d.ts",
      "default": "./dist/semantic-adapter.js"
    }
  },
  "bin": {
    "sig": "./dist/cli/index.js",
    "sig-server": "./dist/server.js",
    "sig-semanticd": "./dist/semanticd-bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "start:daemon": "node dist/cli/index.js daemon",
    "start:server": "node dist/server.js",
    "start:mcp": "node dist/mcp-server.js",
    "start:semanticd": "node dist/semanticd-bin.js",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@myceliumhq/toolkit": "^0.1.0",
    "@myceliumhq/index": "^1.1.1",
    "@myceliumhq/mcp": "^0.1.0",
    "@myceliumhq/semanticd": "^1.1.0",
    "typebox": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@myceliumhq/dev-config": "^0.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.1",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
